---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/site.config';
import { getPublishedPosts } from '@/utils/posts';

const posts = await getPublishedPosts();
---

<BaseLayout>
  <section class="hero container">
    <h1>{SITE.heroTitle}</h1>
    <p class="hero__tagline">{SITE.heroTagline}</p>
    <p class="hero__topics">{SITE.topics.join(' · ')}</p>
    <div class="brand-dash" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  </section>
  <section class="container container--narrow">
    <ul>{posts.map((post) => <li><a href={`/posts/${post.id}/`}>{post.data.title}</a></li>)}</ul>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 5rem;
    padding-bottom: 4rem;
    text-align: center;
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 800;
  }
  .hero__tagline {
    margin: 0.75rem 0 0;
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }
  .hero__topics {
    margin: 1.25rem 0 1.75rem;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--color-text-subtle);
  }
</style>
