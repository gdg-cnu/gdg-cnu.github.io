---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostList from '@/components/PostList.astro';
import TagList from '@/components/TagList.astro';
import SubscribeBox from '@/components/newsletter/SubscribeBox.astro';
import Bracket from '@/components/brand/Bracket.astro';
import Chevron from '@/components/brand/Chevron.astro';
import TypeNav from '@/components/TypeNav.astro';
import { SITE } from '@/site.config';
import { collectTags, countByType, getPublishedPosts } from '@/utils/posts';
import { authorUrl, avatarUrl } from '@/utils/authors';

const posts = await getPublishedPosts();
const recent = posts.slice(0, SITE.homePostCount);
const tags = collectTags(posts).slice(0, 16);
const typeCounts = countByType(posts);
const authors = await getCollection('authors');

/*
 * 홈 배너 연출 타이밍
 * 꺾쇠는 가운데에서 양옆으로 열리고(easeOutCubic), 각 글자는 꺾쇠가 자기 자리를 지나는 순간 나타납니다.
 * 글자 위치는 "가운데에서 몇 번째 글자인가"로 어림하고, 꺾쇠가 그 위치에 닿는 시각을 계산해 지연값으로 씁니다.
 */
const HERO_DELAY = 0.15; // s
const HERO_DURATION = 0.9; // s
const heroChars = [...SITE.heroTitle];
const half = heroChars.length / 2;
const heroLetters = heroChars.map((char, index) => {
  const center = index + 0.5 - half; // 음수: 왼쪽, 양수: 오른쪽
  const distance = Math.min(Math.abs(center) / half, 1); // 0(가운데) ~ 1(끝)
  // easeOutCubic의 역함수: 꺾쇠가 distance만큼 열린 시각 (꺾쇠는 간격만큼 더 바깥에 있어서 0.92를 곱함)
  const reached = 1 - Math.cbrt(1 - distance * 0.92);
  return {
    char: char === ' ' ? '\u00a0' : char,
    delay: `${(HERO_DELAY + HERO_DURATION * reached).toFixed(3)}s`,
    from: center < 0 ? '0.35em' : '-0.35em', // 가운데 쪽에서 바깥으로 밀려나듯 등장
  };
});
---

<BaseLayout>
  <section class="hero container">
    {
      /*
        첫 진입 연출: 가운데 붙어 있던 < > 가 양옆으로 열리고,
        꺾쇠가 지나간 자리의 글자가 하나씩 바깥쪽으로 밀려나듯 나타납니다.
        꺾쇠 위치는 제목 너비 기준 %로 움직여 웹폰트 로드 시점과 무관하게 맞고, 스크립트는 없습니다.
      */
    }
    <div class="hero__mark">
      <h1 aria-label={SITE.heroTitle}>
        <span aria-hidden="true">
          {
            heroLetters.map((letter) => (
              <span class="hero__char" style={`--char-delay:${letter.delay};--char-from:${letter.from}`}>
                {letter.char}
              </span>
            ))
          }
        </span>
      </h1>
      <Bracket side="left" class="hero__bracket hero__bracket--left" />
      <Bracket side="right" class="hero__bracket hero__bracket--right" />
    </div>
    <p class="hero__tagline">{SITE.heroTagline}</p>
    <p class="hero__topics">{SITE.topics.join(' · ')}</p>
  </section>

  <div class="container container--narrow home">
    <section aria-labelledby="recent-heading">
      <div class="section-head">
        <h2 id="recent-heading">최근 글</h2>
        <a href="/posts/">전체 보기 <Chevron side="right" /></a>
      </div>
      <div class="home__types">
        <TypeNav counts={typeCounts} total={posts.length} />
      </div>
      <PostList posts={recent} headingLevel="h3" />
    </section>

    {
      tags.length > 0 && (
        <section aria-labelledby="tags-heading">
          <div class="section-head">
            <h2 id="tags-heading">태그</h2>
            <a href="/tags/">모든 태그 <Chevron side="right" /></a>
          </div>
          <div class="home__tags">
            <TagList tags={tags.map((tag) => tag.name)} />
          </div>
        </section>
      )
    }

    <section aria-labelledby="members-heading">
      <div class="section-head">
        <h2 id="members-heading">글을 쓰는 사람들</h2>
        <a href="/authors/">멤버 보기 <Chevron side="right" /></a>
      </div>
      <ul class="home__members">
        {
          authors.map((author) => (
            <li>
              <a href={authorUrl(author)} title={author.data.name}>
                <img src={avatarUrl(author, 96)} alt={author.data.name} width="44" height="44" loading="lazy" decoding="async" />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <SubscribeBox />
  </div>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 5.5rem;
    padding-bottom: 4.5rem;
    text-align: center;
  }
  .hero__mark {
    --hero-gap: 0.32em;
    --hero-bracket: 0.78em;
    position: relative;
    /* 양옆 꺾쇠 자리만큼 여백을 둬서 가운데 정렬이 유지되게 합니다. */
    margin-inline: calc(var(--hero-bracket) + var(--hero-gap));
    font-size: clamp(1.5rem, 6.4vw, 3rem);
  }
  .hero h1 {
    margin: 0;
    font-size: 1em;
    font-weight: 800;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .hero__char {
    display: inline-block;
    animation: hero-char 0.5s cubic-bezier(0.2, 0, 0, 1) var(--char-delay) both;
  }
  .hero :global(.hero__bracket) {
    position: absolute;
    top: 50%;
    width: var(--hero-bracket);
    height: auto;
    transform: translateY(-50%);
  }
  .hero :global(.hero__bracket--left) {
    right: calc(100% + var(--hero-gap));
    animation: hero-open-left 0.9s cubic-bezier(0.33, 1, 0.68, 1) 0.15s both;
  }
  .hero :global(.hero__bracket--right) {
    left: calc(100% + var(--hero-gap));
    animation: hero-open-right 0.9s cubic-bezier(0.33, 1, 0.68, 1) 0.15s both;
  }
  .hero__tagline {
    margin: 1rem 0 0;
    font-size: 1.125rem;
    color: var(--color-text-muted);
    animation: hero-appear 0.6s ease-out 0.95s both;
  }
  .hero__topics {
    margin: 1.25rem 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--color-text-subtle);
    animation: hero-appear 0.6s ease-out 1.05s both;
  }

  /* 꺾쇠: 제목 가운데(50%)에서 출발해 제목 바깥으로 */
  @keyframes hero-open-left {
    from {
      right: 50%;
    }
  }
  @keyframes hero-open-right {
    from {
      left: 50%;
    }
  }
  /* 글자: 가운데 쪽에서 살짝 밀려나며 나타남 */
  @keyframes hero-char {
    from {
      opacity: 0;
      transform: translateX(var(--char-from));
    }
  }
  @keyframes hero-appear {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 360px) {
    .hero__mark {
      font-size: 1.3rem;
    }
  }

  .home {
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }
  .home__types {
    margin: 0.75rem 0 0.25rem;
  }
  .home__tags {
    margin-top: 1rem;
  }
  .home__members {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .home__members img {
    border-radius: 50%;
    background: var(--color-surface);
    transition: transform 0.2s var(--ease);
  }
  .home__members a:hover img {
    transform: translateY(-2px);
  }
</style>
