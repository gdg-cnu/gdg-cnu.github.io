---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostList from '@/components/PostList.astro';
import TagList from '@/components/TagList.astro';
import SubscribeBox from '@/components/newsletter/SubscribeBox.astro';
import Bracket from '@/components/brand/Bracket.astro';
import Chevron from '@/components/brand/Chevron.astro';
import TypeNav from '@/components/TypeNav.astro';
import { SITE } from '@/site.config';
import { collectTags, countByType, getPublishedPosts } from '@/utils/posts';
import { authorUrl, avatarUrl } from '@/utils/authors';

const posts = await getPublishedPosts();
const recent = posts.slice(0, SITE.homePostCount);
const tags = collectTags(posts).slice(0, 16);
const typeCounts = countByType(posts);
const authors = await getCollection('authors');
---

<BaseLayout>
  <section class="hero container">
    {
      /*
        첫 진입 연출 (Expanding Brackets / Bracket Text Reveal)
        가운데 붙어 있던 < > 가 양옆으로 열리고, 그 사이의 제목은 꺾쇠 안쪽 끝까지만 보입니다.
        꺾쇠 위치와 제목이 보이는 범위를 같은 기준(제목 너비의 %)·같은 곡선으로 움직여서
        보이는 경계가 항상 꺾쇠 안쪽에 붙어 있고, 글자가 꺾쇠 뒤에서 나오는 것처럼 보입니다. (스크립트 없음)
      */
    }
    <div class="hero__mark">
      <h1>{SITE.heroTitle}</h1>
      <Bracket side="left" class="hero__bracket hero__bracket--left" />
      <Bracket side="right" class="hero__bracket hero__bracket--right" />
    </div>
    <p class="hero__tagline">{SITE.heroTagline}</p>
    <p class="hero__topics">{SITE.topics.join(' · ')}</p>
  </section>

  <div class="container container--narrow home">
    <section aria-labelledby="recent-heading">
      <div class="section-head">
        <h2 id="recent-heading">최근 글</h2>
        <a href="/posts/">전체 보기 <Chevron side="right" /></a>
      </div>
      <div class="home__types">
        <TypeNav counts={typeCounts} total={posts.length} />
      </div>
      <PostList posts={recent} headingLevel="h3" />
    </section>

    {
      tags.length > 0 && (
        <section aria-labelledby="tags-heading">
          <div class="section-head">
            <h2 id="tags-heading">태그</h2>
            <a href="/tags/">모든 태그 <Chevron side="right" /></a>
          </div>
          <div class="home__tags">
            <TagList tags={tags.map((tag) => tag.name)} />
          </div>
        </section>
      )
    }

    <section aria-labelledby="members-heading">
      <div class="section-head">
        <h2 id="members-heading">글을 쓰는 사람들</h2>
        <a href="/authors/">멤버 보기 <Chevron side="right" /></a>
      </div>
      <ul class="home__members">
        {
          authors.map((author) => (
            <li>
              <a href={authorUrl(author)} title={author.data.name}>
                <img src={avatarUrl(author, 96)} alt={author.data.name} width="44" height="44" loading="lazy" decoding="async" />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <SubscribeBox />
  </div>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 5.5rem;
    padding-bottom: 4.5rem;
    text-align: center;
  }
  .hero__mark {
    --hero-bracket: 0.78em;
    --hero-ease: cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    /* 양옆 꺾쇠 자리만큼 여백을 둬서 가운데 정렬이 유지되게 합니다. */
    margin-inline: var(--hero-bracket);
    font-size: clamp(1.5rem, 6.4vw, 3rem);
  }
  .hero h1 {
    margin: 0;
    /* 꺾쇠와 글자 사이 간격. 보이는 경계는 이 여백 바깥(=꺾쇠 안쪽 끝)입니다. */
    padding: 0 0.32em;
    font-size: 1em;
    font-weight: 800;
    letter-spacing: -0.03em;
    white-space: nowrap;
    animation:
      hero-reveal 0.9s var(--hero-ease) 0.2s both,
      hero-appear 0.6s ease-out 0.25s both;
  }
  .hero :global(.hero__bracket) {
    position: absolute;
    top: 50%;
    width: var(--hero-bracket);
    height: auto;
    transform: translateY(-50%);
  }
  .hero :global(.hero__bracket--left) {
    right: 100%;
    animation: hero-open-left 0.9s var(--hero-ease) 0.2s both;
  }
  .hero :global(.hero__bracket--right) {
    left: 100%;
    animation: hero-open-right 0.9s var(--hero-ease) 0.2s both;
  }
  .hero__tagline {
    margin: 1rem 0 0;
    font-size: 1.125rem;
    color: var(--color-text-muted);
    animation: hero-appear 0.6s ease-out 0.75s both;
  }
  .hero__topics {
    margin: 1.25rem 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--color-text-subtle);
    animation: hero-appear 0.6s ease-out 0.85s both;
  }

  /* 꺾쇠: 가운데(50%)에서 제목 바깥(100%)으로 */
  @keyframes hero-open-left {
    from {
      right: 50%;
    }
  }
  @keyframes hero-open-right {
    from {
      left: 50%;
    }
  }
  /* 제목: 꺾쇠와 같은 곡선으로 가운데부터 보이는 범위가 넓어짐 */
  @keyframes hero-reveal {
    from {
      clip-path: inset(0 50% 0 50%);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes hero-appear {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 360px) {
    .hero__mark {
      font-size: 1.3rem;
    }
  }

  .home {
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }
  .home__types {
    margin: 0.75rem 0 0.25rem;
  }
  .home__tags {
    margin-top: 1rem;
  }
  .home__members {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .home__members img {
    border-radius: 50%;
    background: var(--color-surface);
    transition: transform 0.2s var(--ease);
  }
  .home__members a:hover img {
    transform: translateY(-2px);
  }
</style>
