---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostList from '@/components/PostList.astro';
import TagList from '@/components/TagList.astro';
import SubscribeBox from '@/components/newsletter/SubscribeBox.astro';
import Bracket from '@/components/brand/Bracket.astro';
import Chevron from '@/components/brand/Chevron.astro';
import TypeNav from '@/components/TypeNav.astro';
import NewsletterList from '@/components/NewsletterList.astro';
import { SITE } from '@/site.config';
import { collectTags, countByType, getPublishedNewsletters, getPublishedPosts } from '@/utils/posts';
import { authorUrl, avatarUrl } from '@/utils/authors';

const posts = await getPublishedPosts();
const recent = posts.slice(0, SITE.homePostCount);
const tags = collectTags(posts).slice(0, 16);
const typeCounts = countByType(posts);
const newsletters = (await getPublishedNewsletters()).slice(0, 3);
const authors = await getCollection('authors');

/*
 * 홈 배너 연출 타이밍 (초) — 에디터 구문 강조처럼
 * 1) 입력: < 제목 > 이 회색으로 왼쪽부터 타이핑되고 커서가 따라감 (단어 단위로 끊어 치는 리듬)
 * 2) 해석: 입력이 끝나면 커서가 사라지고, 에디터가 코드를 읽어들이는 찰나(약 0.22초) 동안 멈춤
 * 3) 강조: 꺾쇠와 제목에 색이 '팟' 하고 켜짐 (꺾쇠는 순간 커졌다 돌아옴, 왼쪽 → 제목 → 오른쪽 아주 짧은 간격)
 * 간격은 고정 시드 난수로 정해서 빌드할 때마다 같은 리듬이 나옵니다.
 */
let seed = 11;
const rand = () => {
  seed = (seed * 9301 + 49297) % 233280;
  return seed / 233280;
};
const TYPE_START = 0.15;
const heroChars: { char: string; at: number; hold: number }[] = [];
// 사람이 치듯 단어 단위로: 단어 안에서는 빠르게, 단어를 마치면 잠깐 멈췄다가 다음 단어
let cursor = TYPE_START + 0.22; // 왼쪽 꺾쇠를 친 뒤 첫 글자까지
for (const char of SITE.heroTitle) {
  const isSpace = char === ' ';
  heroChars.push({ char: isSpace ? '\u00a0' : char, at: cursor, hold: 0 });
  cursor += isSpace ? 0.17 + rand() * 0.08 : 0.045 + rand() * 0.035;
}
const TYPED_AT = cursor + 0.1; // 마지막 글자 뒤 잠깐 쉬고 오른쪽 꺾쇠
heroChars.forEach((item, index) => {
  item.hold = (heroChars[index + 1]?.at ?? TYPED_AT) - item.at;
});
const HIGHLIGHT_AT = TYPED_AT + 0.22; // 에디터가 코드를 읽어들이는 찰나
const fmt = (n: number) => `${n.toFixed(3)}s`;
const heroTiming = [
  `--type-start:${fmt(TYPE_START)}`,
  `--left-hold:${fmt(heroChars[0].at - TYPE_START)}`,
  `--typed-at:${fmt(TYPED_AT)}`,
  `--left-fill:${fmt(HIGHLIGHT_AT)}`,
  `--title-fill:${fmt(HIGHLIGHT_AT + 0.03)}`,
  `--right-fill:${fmt(HIGHLIGHT_AT + 0.06)}`,
  `--fade-at:${fmt(HIGHLIGHT_AT + 0.2)}`,
  `--fade-at-2:${fmt(HIGHLIGHT_AT + 0.3)}`,
].join(';');
---

<BaseLayout>
  <section class="hero container" style={heroTiming}>
    {
      /*
        첫 진입 연출 (입력 → 해석 → 구문 강조). 타이밍은 위 frontmatter 참고.
        이 탭에서 이미 봤다면(새로고침 제외) 연출 없이 완성된 모습으로 보여 줍니다.
        저장소를 쓸 수 없는 환경에서는 오류 없이 그냥 재생합니다.
      */
    }
    <script is:inline>
      (() => {
        const hero = document.currentScript.parentElement;
        try {
          const nav = performance.getEntriesByType('navigation')[0];
          const isReload = nav ? nav.type === 'reload' : false;
          const seen = sessionStorage.getItem('gdg-hero-played') === '1';
          sessionStorage.setItem('gdg-hero-played', '1');
          if (seen && !isReload) hero.classList.add('hero--static');
        } catch {
          // 저장소 접근이 막힌 환경: 연출을 그대로 재생합니다.
        }
      })();
    </script>
    <div class="hero__mark">
      <span class="hero__token hero__token--left">
        <Bracket side="left" class="hero__bracket hero__bracket--left" />
      </span>
      <h1 aria-label={SITE.heroTitle}>
        <span aria-hidden="true">
          {
            heroChars.map((item) => (
              <span class="hero__char" style={`--at:${fmt(item.at)};--hold:${fmt(item.hold)}`}>
                {item.char}
              </span>
            ))
          }
        </span>
      </h1>
      <span class="hero__token hero__token--right">
        <Bracket side="right" class="hero__bracket hero__bracket--right" />
      </span>
    </div>
    <p class="hero__tagline">{SITE.heroTagline}</p>
    <p class="hero__topics">{SITE.topics.join(' · ')}</p>
  </section>

  <div class="container container--narrow home">
    <section aria-labelledby="recent-heading">
      <div class="section-head">
        <h2 id="recent-heading">최근 글</h2>
        <a href="/posts/">전체 보기 <Chevron side="right" /></a>
      </div>
      <div class="home__types">
        <TypeNav counts={typeCounts} total={posts.length} />
      </div>
      <PostList posts={recent} headingLevel="h3" />
    </section>

    {
      newsletters.length > 0 && (
        <section aria-labelledby="newsletter-heading">
          <div class="section-head">
            <h2 id="newsletter-heading">뉴스레터</h2>
            <a href="/newsletter/">
              지난 호 보기 <Chevron side="right" />
            </a>
          </div>
          <NewsletterList issues={newsletters} compact />
        </section>
      )
    }

    {
      tags.length > 0 && (
        <section aria-labelledby="tags-heading">
          <div class="section-head">
            <h2 id="tags-heading">태그</h2>
            <a href="/tags/">모든 태그 <Chevron side="right" /></a>
          </div>
          <div class="home__tags">
            <TagList tags={tags.map((tag) => tag.name)} />
          </div>
        </section>
      )
    }

    <section aria-labelledby="members-heading">
      <div class="section-head">
        <h2 id="members-heading">글을 쓰는 사람들</h2>
        <a href="/authors/">멤버 보기 <Chevron side="right" /></a>
      </div>
      <ul class="home__members">
        {
          authors.map((author) => (
            <li>
              <a href={authorUrl(author)} title={author.data.name}>
                <img src={avatarUrl(author, 96)} alt={author.data.name} width="44" height="44" loading="lazy" decoding="async" />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <SubscribeBox />
  </div>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 5.5rem;
    padding-bottom: 4.5rem;
    text-align: center;
  }
  .hero__mark {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.32em;
    font-size: clamp(1.5rem, 6.4vw, 3rem);
  }
  .hero h1 {
    margin: 0;
    font-size: 1em;
    font-weight: 800;
    letter-spacing: -0.03em;
    white-space: nowrap;
    /* 3) 강조: 회색으로 입력된 제목이 한 번에 본래 색으로 켜짐 */
    animation: hero-title-ink 0.06s linear var(--title-fill) both;
  }
  .hero :global(.hero__bracket) {
    width: 0.78em;
    height: auto;
  }

  /* 1) 입력: 토큰(꺾쇠·글자)이 정해진 시각에 나타남 */
  .hero__token,
  .hero__char {
    position: relative;
    /* 1ms 선형 전환 = 사실상 즉시 등장. (steps(1)은 지연이 길면 부동소수 오차로 끝까지 투명하게 남는 문제가 있음) */
    animation: hero-type 1ms linear var(--at) both;
  }
  .hero__token--left {
    --at: var(--type-start);
    --hold: var(--left-hold);
  }
  .hero__token--right {
    --at: var(--typed-at);
  }
  /* 커서: 방금 입력된 토큰 오른쪽에서, 다음 토큰이 나올 때까지만 보임. 오른쪽 꺾쇠가 입력되면 사라짐 */
  .hero__token--left::after,
  .hero__char::after {
    content: '';
    position: absolute;
    top: 0.14em;
    bottom: 0.14em;
    right: -0.07em;
    width: 0.06em;
    background: var(--color-text);
    opacity: 0;
    animation: hero-caret var(--hold) linear var(--at);
  }
  .hero__token--left::after {
    right: -0.2em;
  }

  /* 3) 강조: 꺾쇠는 회색으로 입력됐다가 왼쪽 → 오른쪽 순서로 색이 '팟' 켜짐 */
  .hero__token--left :global(.hero__bracket) {
    animation: hero-bracket-pop 0.34s cubic-bezier(0.2, 0, 0, 1) var(--left-fill) both;
  }
  .hero__token--right :global(.hero__bracket) {
    animation: hero-bracket-pop 0.34s cubic-bezier(0.2, 0, 0, 1) var(--right-fill) both;
  }

  .hero__tagline {
    margin: 1rem 0 0;
    font-size: 1.125rem;
    color: var(--color-text-muted);
    animation: hero-appear 0.5s ease-out var(--fade-at) both;
  }
  .hero__topics {
    margin: 1.25rem 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--color-text-subtle);
    animation: hero-appear 0.5s ease-out var(--fade-at-2) both;
  }

  /* 이 탭에서 이미 봤으면(새로고침 제외) 처음부터 완성된 모습 */
  .hero--static :is(h1, .hero__token, .hero__char, .hero__tagline, .hero__topics),
  .hero--static :global(.hero__bracket),
  .hero--static .hero__char::after,
  .hero--static .hero__token::after {
    animation: none !important;
  }

  @keyframes hero-type {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes hero-caret {
    from,
    to {
      opacity: 1;
    }
  }
  @keyframes hero-title-ink {
    from {
      color: var(--color-text-subtle);
    }
  }
  /* 색이 '팟' 켜지는 순간 살짝 커지고 밝아졌다가 제자리로 */
  @keyframes hero-bracket-pop {
    0% {
      filter: grayscale(1) brightness(1) opacity(0.7);
      transform: scale(1);
    }
    28% {
      filter: grayscale(0) brightness(1.25) opacity(1);
      transform: scale(1.22);
    }
    100% {
      filter: grayscale(0) brightness(1) opacity(1);
      transform: scale(1);
    }
  }
  @keyframes hero-appear {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 360px) {
    .hero__mark {
      font-size: 1.3rem;
    }
  }

  .home {
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }
  .home__types {
    margin: 0.75rem 0 0.25rem;
  }
  .home__tags {
    margin-top: 1rem;
  }
  .home__members {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .home__members img {
    border-radius: 50%;
    background: var(--color-surface);
    transition: transform 0.2s var(--ease);
  }
  .home__members a:hover img {
    transform: translateY(-2px);
  }
</style>
