---
import { Image } from 'astro:assets';
import AuthorByline from './AuthorByline.astro';
import TagList from './TagList.astro';
import { getPostAuthors, readingMinutes, type Post } from '@/utils/posts';
import { formatDate, isoDate } from '@/utils/date';

interface Props {
  post: Post;
  /** 목록 제목 태그 수준 (페이지 h1 아래면 h2) */
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel = 'h2' } = Astro.props;
const { title, description, date, tags, thumbnail, thumbnailAlt, draft } = post.data;
const authors = await getPostAuthors(post);
const minutes = readingMinutes(post.body);
const href = `/posts/${post.id}/`;
const Heading = headingLevel;
---

<article class="post-item">
  <div class="post-item__body">
    <TagList tags={tags} variant="inline" />
    <Heading class="post-item__title">
      <a href={href}>
        {draft && <span class="post-item__draft">초안</span>}
        {title}
      </a>
    </Heading>
    <p class="post-item__desc">{description}</p>
    <div class="post-item__meta">
      <AuthorByline authors={authors} size={20} />
      <span aria-hidden="true">·</span>
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
      <span aria-hidden="true">·</span>
      <span>{minutes}분</span>
    </div>
  </div>
  {
    thumbnail && (
      <a href={href} class="post-item__thumb" tabindex="-1" aria-hidden="true">
        <Image src={thumbnail} alt={thumbnailAlt ?? ''} widths={[240, 480]} sizes="240px" />
      </a>
    )
  }
</article>

<style>
  .post-item {
    display: flex;
    gap: 2rem;
    align-items: center;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .post-item__body {
    flex: 1;
    min-width: 0;
  }
  .post-item__title {
    margin: 0.4rem 0 0;
    font-size: 1.3125rem;
    font-weight: 700;
    line-height: 1.4;
  }
  .post-item__title a {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.25s var(--ease);
  }
  .post-item__title a:hover {
    background-size: 100% 1px;
  }
  .post-item__draft {
    display: inline-block;
    margin-right: 0.4rem;
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--gdg-yellow) 25%, transparent);
    font-size: 0.75rem;
    vertical-align: 0.2em;
  }
  .post-item__desc {
    display: -webkit-box;
    margin: 0.4rem 0 0;
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .post-item__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.9rem;
    font-size: 0.8125rem;
    color: var(--color-text-subtle);
  }
  .post-item__meta :global(.byline__names a) {
    font-weight: 500;
    color: var(--color-text-muted);
  }
  .post-item__thumb {
    flex-shrink: 0;
    width: 200px;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }
  .post-item__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s var(--ease);
  }
  .post-item:hover .post-item__thumb :global(img) {
    transform: scale(1.03);
  }

  @media (max-width: 640px) {
    .post-item {
      gap: 1rem;
      align-items: flex-start;
    }
    .post-item__title {
      font-size: 1.125rem;
    }
    .post-item__thumb {
      width: 96px;
      aspect-ratio: 1;
      margin-top: 1.6rem;
    }
  }
</style>
