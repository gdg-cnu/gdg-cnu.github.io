---
import { Image } from 'astro:assets';
import { NAV, SITE } from '@/site.config';
import ThemeToggle from './ThemeToggle.astro';
import icon from '@/assets/brand/gdg-icon.png';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${SITE.title} 홈`}>
      <Image src={icon} alt="" width={28} height={28} class="brand__icon" loading="eager" />
      <span class="brand__name">{SITE.brand}</span>
      <span class="brand__sub">{SITE.brandSub}</span>
    </a>

    <nav class="site-nav" aria-label="주요 메뉴">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="site-nav__actions">
        <a href="/search/" class="icon-button" aria-label="검색" title="검색">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
        </a>
        <a href="/rss.xml" class="icon-button" aria-label="RSS 피드" title="RSS 피드">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14"></path>
            <circle cx="6" cy="18" r="1.2" fill="currentColor"></circle>
          </svg>
        </a>
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
    background: var(--color-bg-blur);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s var(--ease);
  }
  :global(html.is-scrolled) .site-header {
    border-bottom-color: var(--color-border);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }
  .brand__icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }
  .brand__name {
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .brand__sub {
    padding-left: 0.55rem;
    border-left: 1px solid var(--color-border-strong);
    color: var(--color-text-muted);
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .site-nav ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav ul a {
    display: block;
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    transition:
      color 0.15s var(--ease),
      background-color 0.15s var(--ease);
  }
  .site-nav ul a:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }
  .site-nav ul a[aria-current='page'] {
    color: var(--color-text);
    font-weight: 600;
  }
  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  :global(.icon-button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color 0.15s var(--ease),
      background-color 0.15s var(--ease);
  }
  :global(.icon-button:hover) {
    color: var(--color-text);
    background: var(--color-surface);
  }

  @media (max-width: 720px) {
    .brand__sub {
      display: none;
    }
    .site-nav {
      gap: 0.25rem;
    }
    .site-nav ul a {
      padding: 0.35rem 0.45rem;
    }
  }
  @media (max-width: 480px) {
    .brand__name {
      font-size: 0.9375rem;
    }
    .site-nav__actions a[href='/rss.xml'] {
      display: none;
    }
  }
  @media (max-width: 400px) {
    .brand__name {
      display: none;
    }
  }
</style>

<script>
  const onScroll = () => document.documentElement.classList.toggle('is-scrolled', window.scrollY > 4);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
