---
/** 뉴스레터 회차 목록: #3  제목 / 설명  ·  날짜 */
import type { Newsletter } from '@/utils/posts';
import { newsletterUrl } from '@/utils/posts';
import { formatDate, isoDate } from '@/utils/date';

interface Props {
  issues: Newsletter[];
  /** 설명 줄 표시 여부 (홈처럼 좁게 보여줄 때 끔) */
  compact?: boolean;
}

const { issues, compact = false } = Astro.props;
---

{
  issues.length > 0 ? (
    <ol class:list={['issues', { 'issues--compact': compact }]}>
      {issues.map((issue) => (
        <li>
          <a href={newsletterUrl(issue)} class="issue">
            <span class="issue__no">#{issue.data.issue}</span>
            <span class="issue__body">
              <span class="issue__title">
                {issue.data.draft && <span class="issue__draft">초안</span>}
                {issue.data.title}
              </span>
              {!compact && <span class="issue__desc">{issue.data.description}</span>}
            </span>
            <time class="issue__date" datetime={isoDate(issue.data.date)}>
              {formatDate(issue.data.date)}
            </time>
          </a>
        </li>
      ))}
    </ol>
  ) : (
    <p class="issues__empty">첫 뉴스레터를 준비하고 있어요.</p>
  )
}

<style>
  .issues {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .issue {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .issues li:last-child .issue {
    border-bottom: 0;
  }
  .issue__no {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text-subtle);
  }
  .issue__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .issue__title {
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.45;
  }
  .issue:hover .issue__title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .issue__desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
  .issue__date {
    font-size: 0.8125rem;
    color: var(--color-text-subtle);
    white-space: nowrap;
  }
  .issue__draft {
    display: inline-block;
    margin-right: 0.4rem;
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--gdg-yellow) 25%, transparent);
    font-size: 0.75rem;
    vertical-align: 0.15em;
  }
  .issues--compact .issue {
    padding: 0.75rem 0;
  }
  .issues--compact .issue__title {
    font-size: 1rem;
  }
  .issues__empty {
    padding: 2rem 0;
    text-align: center;
    color: var(--color-text-muted);
  }

  @media (max-width: 560px) {
    .issue {
      grid-template-columns: 2.5rem 1fr;
    }
    .issue__date {
      grid-column: 2;
    }
  }
</style>
